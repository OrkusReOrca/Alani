# Copy to ".env" and adjust if needed — these defaults match the current setup.

# Ollama model tag for the conversational brain.
ALANI_OLLAMA_MODEL=qwen3:8b

# faster-whisper settings.
ALANI_WHISPER_MODEL=small
ALANI_WHISPER_DEVICE=cuda
ALANI_WHISPER_COMPUTE_TYPE=int8_float16

# Which repo the GitHub bridge triggers workflows in.
ALANI_GITHUB_BOT_REPO=OrkusReOrca/Alani-Bot

# Web search — free Brave Search API key from https://brave.com/search/api/
# (2,000 queries/month free tier, no credit card). Leave unset to disable.
ALANI_BRAVE_SEARCH_API_KEY=
